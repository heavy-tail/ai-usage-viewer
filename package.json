{
  "name": "usage-viewer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:agy-job-host": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-agy-job-host.ps1",
    "predev": "npm run build:agy-job-host",
    "dev": "vite",
    "preapi": "npm run build:agy-job-host",
    "api": "tsx src/server.ts",
    "prestart": "npm run build:agy-job-host",
    "start": "tsx src/server.ts",
    "precollect": "npm run build:agy-job-host",
    "collect": "tsx src/collect.ts",
    "precompatibility:check": "npm run build:agy-job-host",
    "compatibility:check": "tsx src/checkCompatibility.ts",
    "pretest": "npm run build:agy-job-host",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "prebuild": "npm run build:agy-job-host",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.8"
  }
}
